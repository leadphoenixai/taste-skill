# ── Required ──────────────────────────────────────────────────────────────────
# Create a Discord application at https://discord.com/developers/applications
# then copy the bot token here.
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# ── Hermes API ────────────────────────────────────────────────────────────────
# Base URL of your OpenAI-compatible endpoint.
# Ollama (default):      http://localhost:11434/v1
# LM Studio:             http://localhost:1234/v1
# vLLM:                  http://localhost:8000/v1
# Remote / hosted:       https://your-server.example.com/v1
HERMES_API_BASE=http://localhost:11434/v1

# API key — local servers often accept any non-empty string.
# For Ollama use "ollama"; for LM Studio use "lm-studio".
HERMES_API_KEY=ollama

# Exact model name as returned by your server's /v1/models endpoint.
# Ollama examples:   hermes3   hermes3:8b   hermes3:70b
# vLLM examples:     NousResearch/Hermes-3-Llama-3.1-8B
HERMES_MODEL=hermes3

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the system prompt sent to Hermes.
# HERMES_SYSTEM_PROMPT=You are Hermes, a helpful and knowledgeable AI assistant.

# Max chat messages kept in memory per channel (user + assistant turns combined).
# HERMES_MAX_HISTORY=20
